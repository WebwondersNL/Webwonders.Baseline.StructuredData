@inherits UmbracoViewPage
@{
    Layout = null;
    var home = Model.Root();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Name · @home.Name</title>
    <link rel="stylesheet" href="/css/site.css" />

    @* This is all a project needs to render its structured data. *@
    <structured-data />
</head>
<body>
    <header class="site-header">
        <a class="brand" href="@home.Url()">@home.Name</a>
        <nav>
            @foreach (var item in home.DescendantsOrSelf().Where(p => p.Level <= 3))
            {
                <a href="@item.Url()" class="@(item.Id == Model.Id ? "active" : null)">@item.Name</a>
            }
        </nav>
    </header>

    <main class="content">
        @RenderBody()
    </main>

    <partial name="StructuredDataPanel" />
</body>
</html>